{
  "name": "ctf.pages.dev",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "tsc -b && vite build",
    "prestart": "make",
    "prebuild": "make",
    "test": "vitest",
    "preview": "npm run build && wrangler pages dev",
    "fmt": "prettier --write ."
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26",
    "cldr-localenames-full": "^48.2.0",
    "mrmime": "^2.0.1",
    "prettier": "^3.9.9",
    "typescript": "^7",
    "vite": "^8",
    "vitest": "^5",
    "wrangler": "^4.149.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "keywords": [],
  "author": "nilfalse",
  "homepage": "https://ctf.pages.dev/",
  "license": "MPL-2.0",
  "prettier": {
    "plugins": [
      "@trivago/prettier-plugin-sort-imports"
    ],
    "importOrder": [
      "<BUILTIN_MODULES>",
      "<THIRD_PARTY_MODULES>",
      "^~(?!.*\\.css(?:\\?.*)?$)(.+)$",
      "^(?:\\.{1,2}/)(?!\\+)(?!.*\\.css(?:\\?.*)?$).*",
      "^\\./\\+.*$",
      "\\.css(?:\\?.*)?$"
    ],
    "importOrderSeparation": true,
    "singleQuote": true
  }
}
